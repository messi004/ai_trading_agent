# =============================================================================
# ICICI Direct Breeze API Credentials
# Get from: https://api.icicidirect.com/apiuser/login
# =============================================================================
ICICI_API_KEY=
ICICI_API_SECRET=
# Session token. Leave EMPTY at boot: it is pushed automatically via Telegram
# (`/session <token>`) and the pipeline upgrades from stub to the real feed.
# If you prefer a static token, set it here (expires ~daily / midnight).
ICICI_SESSION_TOKEN=
# Optional auto-login (used when ICICI_SESSION_TOKEN is empty / to refresh):
# ICICI_USER_ID=your_trading_userid
# ICICI_PASSWORD=your_password
# ICICI_DATE_OF_BIRTH=DD-MM-YYYY

# Nifty 50 Index Option underlyings to subscribe
NIFTY_SYMBOL=NIFTY
NIFTY_EXPIRY=weekly

# =============================================================================
# Google Gemini (Embeddings + LLM) - via OpenAI-compatible endpoint
# Get API key from: https://aistudio.google.com/apikey
# =============================================================================
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.5-flash
LLM_TEMPERATURE=0.3

# =============================================================================
# Telegram
# =============================================================================
# Bot token from @BotFather. Chat IDs from @userinfobot (your own chat = alerts
# + the ops channel that may send `/session <token>` to refresh the session).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Qdrant Vector DB
# =============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nifty_historical_traps

# =============================================================================
# App Behaviour
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
MARKET_OPEN_IST=09:15
MARKET_CLOSE_IST=15:30
HEALTH_PORT=8080

# Threshold profile: AGGRESSIVE | MODERATE | CONSERVATIVE
THRESHOLD_PROFILE=MODERATE
